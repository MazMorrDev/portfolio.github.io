---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
---

<Layout>
  <section class="projects-hero py-3">
    <div class="container">
      <div class="text-center mb-3">
        <h1>My Projects</h1>
        <p class="subtitle">
          A showcase of my work, focusing on backend development with .NET and
          full-stack applications
        </p>
      </div>

      <div class="projects-grid">
        <ProjectCard
          title="MazERP - Enterprise Resource Planning"
          description="A comprehensive full-stack business management system built with modern .NET and Angular. This project has a complex structure and includes the best practices of the market right now, it is my main project for demonstrating abilities. Made it like if it was an real project to prove myself. The Frontend code is currently in progress and soon will be available a live demo of the project"
          technologies={[
            "C#",
            "ASP.NET Core",
            "Entity Framework",
            "Angular",
            "TypeScript",
            "SQL Server",
            "REST API",
            "JWT",
          ]}
          backendRepo="https://github.com/MazMorrDev/MazERP-API"
        />

        <ProjectCard
          title="MiniMazERP"
          description="A comprehensive full-stack business management system built with modern .NET and Angular. Features complete CRUD operations for inventory, users, and expenses with modular architecture. The backend implements RESTful APIs with Entity Framework, while the frontend provides a responsive Angular interface. Made it as part of an University Project"
          technologies={[
            "C#",
            "ASP.NET Core",
            "Entity Framework",
            "Angular",
            "TypeScript",
            "SQL Server",
            "REST API",
            "JWT",
          ]}
          backendRepo="https://github.com/MazMorrDev/MiniMazERP-API"
          frontendRepo="https://github.com/MazMorrDev/MiniMazERP-Web"
        />

        <ProjectCard
          title="Bussines Manager"
          description="A desktop application for comprehensive inventory management in small and medium-sized businesses. Built with Spring Boot for business logic and JavaFX for the graphical interface, it allows managing products, categories, warehouses, and transactions, with PDF/Excel export functionality and user authentication."
          technologies={[
            "Java",
            "Spring Boot",
            "JavaFX",
            "H2 Database",
            "Maven",
            "Scene Builder",
            "MVC Architecture",
          ]}
          fullStackRepo="https://github.com/MazMorrDev/Business-Manager-Lite"
        />

        <ProjectCard
          title="MazTUB - Telegram User bot"
          description="UserBot created to automatically manage my account at telegram."
          technologies={["C#", "WTelegram"]}
          fullStackRepo="https://github.com/MazMorrDev/MazTUB"
        />
      </div>

      <div class="github-cta text-center mt-3">
        <h3>Want to see more?</h3>
        <p>
          Check out my GitHub profile for additional projects, code samples, and
          contributions
        </p>
        <a
          href="https://github.com/MazMorrDev"
          target="_blank"
          rel="noopener noreferrer"
          class="btn mt-1"
        >
          Visit My GitHub
        </a>
      </div>
    </div>
  </section>

  <section class="py-3" style="background-color: var(--secondary-black);">
    <div class="container">
      <h2 class="text-center mb-3">Development Approach</h2>

      <div class="approach-grid">
        <div class="approach-card">
          <div class="philosophy-number">01</div>
          <h3>Architecture First</h3>
          <p>
            Focus on clean architecture, SOLID principles, and scalable design
            patterns from the start of every project.
          </p>
        </div>

        <div class="approach-card">
          <div class="philosophy-number">02</div>
          <h3>Database Integration</h3>
          <p>
            Expertise in SQL databases, implementing efficient data models and
            optimized queries for each use case.
          </p>
        </div>

        <div class="approach-card">
          <div class="philosophy-number">03</div>
          <h3>Security Focused</h3>
          <p>
            Build secure applications with proper authentication, authorization,
            and data protection mechanisms using JWT and role-based access
            control.
          </p>
        </div>

        <div class="approach-card">
          <div class="philosophy-number">04</div>
          <h3>Full-Stack Development</h3>
          <p>
            Create complete applications from database design to frontend
            implementation, ensuring seamless integration across all layers.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .projects-hero {
    min-height: 100vh;
  }

  .subtitle {
    font-size: 1.2rem;
    color: #ddd;
    max-width: 600px;
    margin: 0 auto 2rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
    margin: 2rem 0;
  }

  .github-cta {
    padding: 3rem;
    background-color: var(--secondary-black);
    border-radius: 8px;
    border: 1px solid var(--medium-gray);
  }

  .github-cta h3 {
    color: var(--primary-white);
    margin-bottom: 0.5rem;
  }

  .github-cta p {
    color: #ddd;
  }

  .approach-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .approach-card {
    text-align: center;
    padding: 2rem;
    background-color: var(--primary-black);
    border-radius: 8px;
    border: 1px solid var(--medium-gray);
    transition: var(--transition);
  }

  .philosophy-number {
    font-size: 3rem;
    font-weight: 700;
    color: rgba(255, 0, 0, 0.781);
    margin-bottom: 1rem;
    line-height: 1;
  }

  .approach-card:hover {
    border-color: var(--primary-red);
    transform: translateY(-5px);
  }

  .approach-card h3 {
    color: var(--primary-white);
    margin-bottom: 1rem;
  }

  .approach-card p {
    color: #ddd;
  }

  .tech-stack-demo {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 3rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .tech-category {
    background-color: var(--secondary-black);
    padding: 2rem;
    border-radius: 8px;
    border: 1px solid var(--medium-gray);
  }

  .tech-category h3 {
    color: var(--primary-red);
    margin-bottom: 1.5rem;
    text-align: center;
    border: none;
  }

  .tech-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .tech-item {
    display: flex;
    flex-direction: column;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--medium-gray);
  }

  .tech-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .tech-name {
    color: var(--primary-white);
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .tech-desc {
    color: #ddd;
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .tech-stack-demo {
      grid-template-columns: 1fr;
    }
  }
</style>
