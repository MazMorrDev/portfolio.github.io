---
import Layout from "../layouts/Layout.astro";
import Welcome from "../components/Welcome.astro";
import ProjectCard from "../components/ProjectCard.astro";
---

<Layout>
  <Welcome />

  <section class="py-3">
    <div class="container">
      <div class="text-center mb-3">
        <h2>Featured Projects</h2>
        <p>
          Check out some of my recent work showcasing my backend development
          skills
        </p>
      </div>

      <div class="projects-grid">
        <ProjectCard
          title="MazERP - Enterprise Resource Planning"
          description="A comprehensive full-stack business management system built with modern .NET and Angular. This project has a complex structure and includes the best practices of the market right now, it is my main project for demonstrating abilities. Made it like if it was an real project to prove myself. The Frontend code is currently in progress and soon will be available a live demo of the project"
          technologies={[
            "C#",
            "ASP.NET Core",
            "Entity Framework",
            "Angular",
            "TypeScript",
            "SQL Server",
            "REST API",
            "JWT",
          ]}
          backendRepo="https://github.com/MazMorrDev/MazERP-API"
        />

        <ProjectCard
          title="Bussines Manager"
          description="A desktop application for comprehensive inventory management in small and medium-sized businesses. Built with Spring Boot for business logic and JavaFX for the graphical interface, it allows managing products, categories, warehouses, and transactions, with PDF/Excel export functionality and user authentication."
          technologies={[
            "Java",
            "Spring Boot",
            "JavaFX",
            "H2 Database",
            "Maven",
            "Scene Builder",
            "MVC Architecture",
          ]}
          fullStackRepo="https://github.com/MazMorrDev/Business-Manager-Lite"
        />
      </div>

      <div class="text-center mt-3">
        <a href="/projects/" class="btn">View All Projects</a>
      </div>
    </div>
  </section>

  <section class="py-3" style="background-color: var(--secondary-black);">
    <div class="container">
      <div class="text-center mb-3">
        <h2>Technologies I Use</h2>
        <p>
          My technical stack spans across backend, frontend, and database
          technologies
        </p>
      </div>

      <div class="quick-skills">
        <div class="skill-category">
          <h3>Backend</h3>
          <p>C#, .NET, ASP.NET Core, Java, Spring Boot</p>
        </div>

        <div class="skill-category">
          <h3>Frontend</h3>
          <p>TypeScript, Angular, HTML5, CSS3, JavaFX</p>
        </div>

        <div class="skill-category">
          <h3>Databases</h3>
          <p>PostgreSQL, MySQL, SQLite, SQL Server</p>
        </div>
      </div>

      <div class="text-center mt-3">
        <a href="/skills/" class="btn btn-outline">See All Skills</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin: 2rem 0;
  }

  .quick-skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .skill-category {
    text-align: center;
    padding: 2rem;
    background-color: var(--primary-black);
    border-radius: 8px;
    border: 1px solid var(--medium-gray);
  }

  .skill-category h3 {
    color: var(--primary-red);
    margin-bottom: 1rem;
  }

  .skill-category p {
    color: #ddd;
  }
</style>
