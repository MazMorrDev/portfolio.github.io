---
import Layout from "../layouts/Layout.astro";
import TechCarousel from "../components/TechCarousel.astro";
import { Image } from "astro:assets";
import Footer from "../components/Footer.astro";
---

<Layout>
  <section class="skills-hero py-3">
    <div class="container">
      <div class="text-center mb-4">
        <h1>Technical Expertise</h1>
        <p class="subtitle">
          My comprehensive skill set across backend development, databases, and
          modern technologies
        </p>
      </div>

      <!-- Carrusel Principal de Tecnologías -->
      <div class="main-carousel-section fade-in">
        <h2 class="text-center mb-3">My Technology Stack</h2>
        <div class="carousel-categories">
          <div class="category-tabs">
            <button class="category-tab active" data-category="backend"
              >Backend</button
            >
            <button class="category-tab" data-category="frontend"
              >Frontend</button
            >
            <button class="category-tab" data-category="database"
              >Databases</button
            >
            <button class="category-tab" data-category="tools"
              >Tools & DevOps</button
            >
          </div>

          <div class="category-content active" id="backend-carousel">
            <TechCarousel category="backend" />
          </div>

          <div class="category-content" id="frontend-carousel">
            <TechCarousel category="frontend" />
          </div>

          <div class="category-content" id="database-carousel">
            <TechCarousel category="database" />
          </div>

          <div class="category-content" id="tools-carousel">
            <TechCarousel category="tools" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Nivel de Maestría -->
  <section class="proficiency-section py-3">
    <div class="container">
      <h2 class="text-center mb-4">Skill Proficiency Levels</h2>

      <div class="proficiency-grid">
        <div class="proficiency-category">
          <div class="proficiency-header expert">
            <h3>Expert Level</h3>
            <p>Deep knowledge & professional experience</p>
          </div>
          <div class="skills-visual">
            <div class="skill-visual-item">
              <div class="skill-visual-logo">
                <Image
                  src={"https://cdn.jsdelivr.net/gh/devicons/devicon/icons/csharp/csharp-original.svg"}
                  alt={"C#"}
                  width={60}
                  height={60}
                  loading="lazy"
                  format="webp"
                  quality="low"
                />
              </div>
              <span class="skill-visual-name">C#</span>
            </div>
            <div class="skill-visual-item">
              <div class="skill-visual-logo">
                <Image
                  src={"https://cdn.jsdelivr.net/gh/devicons/devicon/icons/dotnetcore/dotnetcore-original.svg"}
                  alt={".NET"}
                  width={60}
                  height={60}
                  loading="lazy"
                  format="webp"
                  quality="low"
                />
              </div>
              <span class="skill-visual-name">.NET</span>
            </div>
            <div class="skill-visual-item">
              <div class="skill-visual-logo">
                <Image
                  src={"https://cdn.jsdelivr.net/gh/devicons/devicon/icons/dot-net/dot-net-original.svg"}
                  alt={"ASP.NET"}
                  width={60}
                  height={60}
                  loading="lazy"
                  format="webp"
                  quality="low"
                />
              </div>
              <span class="skill-visual-name">ASP.NET Core</span>
            </div>
            <div class="skill-visual-item">
              <div class="skill-visual-logo">
                <Image
                  src={"https://cdn.jsdelivr.net/gh/devicons/devicon/icons/dot-net/dot-net-original.svg"}
                  alt={"EF"}
                  width={60}
                  height={60}
                  loading="lazy"
                  format="webp"
                  quality="low"
                />
              </div>
              <span class="skill-visual-name">Entity Framework</span>
            </div>
          </div>
        </div>

        <div class="proficiency-category">
          <div class="proficiency-header advanced">
            <h3>Advanced Level</h3>
            <p>Strong experience & complex projects</p>
          </div>
          <div class="skills-visual">
            <div class="skill-visual-item">
              <div class="skill-visual-logo">
                <Image
                  src={"https://cdn.jsdelivr.net/gh/devicons/devicon/icons/java/java-original.svg"}
                  alt={"Java"}
                  width={60}
                  height={60}
                  loading="lazy"
                  format="webp"
                  quality="low"
                />
              </div>
              <span class="skill-visual-name">Java</span>
            </div>
            <div class="skill-visual-item">
              <div class="skill-visual-logo">
                <Image
                  src={"https://cdn.jsdelivr.net/gh/devicons/devicon/icons/spring/spring-original.svg"}
                  alt={"Spring"}
                  width={60}
                  height={60}
                  loading="lazy"
                  format="webp"
                  quality="low"
                />
              </div>
              <span class="skill-visual-name">Spring Boot</span>
            </div>
            <div class="skill-visual-item">
              <div class="skill-visual-logo">
                <Image
                  src={"https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg"}
                  alt={"PostgreSQL"}
                  width={60}
                  height={60}
                  loading="lazy"
                  format="webp"
                  quality="low"
                />
              </div>
              <span class="skill-visual-name">PostgreSQL</span>
            </div>
            <div class="skill-visual-item">
              <div class="skill-visual-logo">
                <Image
                  src={"https://cdn.jsdelivr.net/gh/devicons/devicon/icons/angularjs/angularjs-original.svg"}
                  alt={"Angular"}
                  width={60}
                  height={60}
                  loading="lazy"
                  format="webp"
                  quality="low"
                />
              </div>
              <span class="skill-visual-name">Angular</span>
            </div>
          </div>
        </div>

        <div class="proficiency-category">
          <div class="proficiency-header intermediate">
            <h3>Intermediate Level</h3>
            <p>Good experience & working knowledge</p>
          </div>
          <div class="skills-visual">
            <div class="skill-visual-item">
              <div class="skill-visual-logo">
                <Image
                  src={"https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mysql/mysql-original.svg"}
                  alt={"MySQL"}
                  width={60}
                  height={60}
                  loading="lazy"
                  format="webp"
                  quality="low"
                />
              </div>
              <span class="skill-visual-name">MySQL</span>
            </div>
            <div class="skill-visual-item">
              <div class="skill-visual-logo">
                <Image
                  src={"https://cdn.jsdelivr.net/npm/simple-icons@v5/icons/microsoftsqlserver.svg"}
                  alt={"SQL Server"}
                  width={60}
                  height={60}
                  loading="lazy"
                  format="webp"
                  quality="low"
                />
              </div>
              <span class="skill-visual-name">SQL Server</span>
            </div>
            <div class="skill-visual-item">
              <div class="skill-visual-logo">
                <Image
                  src={"https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg"}
                  alt={"Docker"}
                  width={60}
                  height={60}
                  loading="lazy"
                  format="webp"
                  quality="low"
                />
              </div>
              <span class="skill-visual-name">Docker</span>
            </div>
            <div class="skill-visual-item">
              <div class="skill-visual-logo">
                <Image
                  src={"https://cdn.jsdelivr.net/gh/devicons/devicon/icons/apache/apache-original.svg"}
                  alt={"Maven"}
                  width={60}
                  height={60}
                  loading="lazy"
                  format="webp"
                  quality="low"
                />
              </div>
              <span class="skill-visual-name">Maven</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Filosofía de Desarrollo -->
  <section class="philosophy-section py-3">
    <div class="container">
      <h2 class="text-center mb-4">Development Philosophy</h2>

      <div class="philosophy-grid">
        <div class="philosophy-item">
          <div class="philosophy-number">01</div>
          <h3>Clean Code First</h3>
          <p>
            Writing maintainable, readable, and well-structured code following
            SOLID principles and best practices.
          </p>
        </div>

        <div class="philosophy-item">
          <div class="philosophy-number">02</div>
          <h3>Test-Driven Development</h3>
          <p>
            Implementing comprehensive testing strategies to ensure software
            quality and reliability from the start.
          </p>
        </div>

        <div class="philosophy-item">
          <div class="philosophy-number">03</div>
          <h3>Continuous Learning</h3>
          <p>
            Staying updated with latest technologies and methodologies to
            deliver modern, efficient solutions.
          </p>
        </div>

        <div class="philosophy-item">
          <div class="philosophy-number">04</div>
          <h3>Problem Solving</h3>
          <p>
            Focusing on understanding requirements deeply and architecting
            optimal solutions for real-world challenges.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
<Footer />

<script>
  document.addEventListener("DOMContentLoaded", () => {
    function showCategory(category: string | null): void {
      // Ocultar todos los contenidos
      document
        .querySelectorAll<HTMLElement>(".category-content")
        .forEach((content: HTMLElement) => {
          content.classList.remove("active");
        });

      // Remover clase active de todas las pestañas
      document
        .querySelectorAll<HTMLButtonElement>(".category-tab")
        .forEach((tab: HTMLButtonElement) => {
          tab.classList.remove("active");
        });

      // Mostrar contenido seleccionado si category no es null
      if (category) {
        const targetContent: HTMLElement | null = document.getElementById(
          `${category}-carousel`,
        );
        if (targetContent) {
          targetContent.classList.add("active");
        }

        // Activar pestaña seleccionada
        const targetTab: HTMLElement | null = document.querySelector(
          `.category-tab[data-category="${category}"]`,
        );
        if (targetTab) {
          targetTab.classList.add("active");
        }
      }
    }

    // Agregar event listeners a todos los botones de categoría
    document
      .querySelectorAll<HTMLButtonElement>(".category-tab")
      .forEach((button: HTMLButtonElement) => {
        button.addEventListener("click", () => {
          const category: string | null = button.getAttribute("data-category");
          showCategory(category);
        });
      });

    // Establecer la primera categoría como activa por defecto
    showCategory("backend");
  });
</script>

<style>
  /* Estilos generales */
  .skills-hero {
    min-height: 100vh;
    padding-top: 3rem;
  }

  .subtitle {
    font-size: 1.2rem;
    color: #ddd;
    max-width: 600px;
    margin: 0 auto 3rem;
  }

  /* Carrusel Principal */
  .main-carousel-section {
    margin-bottom: 4rem;
  }

  .carousel-subtitle {
    color: #ddd;
    max-width: 600px;
    margin: 0 auto;
  }

  .carousel-categories {
    background-color: var(--secondary-black);
    border-radius: 16px;
    padding: 2rem;
    border: 1px solid var(--medium-gray);
  }

  .category-tabs {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .category-tab {
    padding: 0.8rem 1.5rem;
    background-color: var(--primary-black);
    border: 1px solid var(--medium-gray);
    border-radius: 8px;
    color: #ddd;
    cursor: pointer;
    transition: all 0.3s ease;
    font-weight: 500;
    border: none;
    font-family: inherit;
    font-size: inherit;
  }

  .category-tab:hover {
    background-color: var(--medium-gray);
  }

  .category-tab.active {
    background-color: var(--primary-red);
    border-color: var(--primary-red);
    color: var(--primary-white);
  }

  .category-content {
    display: none;
  }

  .category-content.active {
    display: block;
  }

  /* Secciones con fondo común */
  .proficiency-section,
  .philosophy-section {
    background-color: var(--secondary-black);
  }

  /* Niveles de Maestría */
  .proficiency-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .proficiency-category {
    background-color: var(--primary-black);
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--medium-gray);
  }

  .proficiency-header {
    padding: 1.5rem;
    text-align: center;
    border-bottom: 3px solid;
  }

  .proficiency-header h3 {
    color: var(--primary-white);
    margin-bottom: 0.5rem;
  }

  .proficiency-header p {
    color: #ddd;
    font-size: 0.9rem;
  }

  .proficiency-header.expert {
    background-color: rgba(76, 175, 80, 0.1);
    border-bottom-color: #4caf50;
  }

  .proficiency-header.advanced {
    background-color: rgba(255, 193, 7, 0.1);
    border-bottom-color: #ffc107;
  }

  .proficiency-header.intermediate {
    background-color: rgba(33, 150, 243, 0.1);
    border-bottom-color: #2196f3;
  }

  .skills-visual {
    padding: 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    gap: 1.5rem;
  }

  .skill-visual-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }

  .skill-visual-logo {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--secondary-black);
    border-radius: 12px;
    padding: 0.8rem;
    border: 1px solid var(--medium-gray);
    transition: all 0.3s ease;
  }

  .skill-visual-logo:hover {
    transform: scale(1.1);
    border-color: var(--primary-red);
  }

  .skill-visual-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .skill-visual-name {
    color: var(--primary-white);
    font-size: 0.9rem;
    font-weight: 500;
  }

  /* Filosofía de Desarrollo */
  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .philosophy-item {
    background-color: var(--primary-black);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid var(--medium-gray);
    position: relative;
    overflow: hidden;
  }

  .philosophy-item::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 5px;
    height: 100%;
    background-color: var(--primary-red);
  }

  .philosophy-number {
    font-size: 3rem;
    font-weight: 700;
    color: rgba(255, 0, 0, 0.781);
    margin-bottom: 1rem;
    line-height: 1;
  }

  .philosophy-item h3 {
    color: var(--primary-white);
    margin-bottom: 1rem;
    font-size: 1.3rem;
  }

  .philosophy-item p {
    color: #ddd;
    font-size: 0.95rem;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .proficiency-grid {
      grid-template-columns: 1fr;
    }

    .category-tabs {
      flex-direction: column;
    }

    .category-tab {
      width: 100%;
      text-align: center;
    }

    .skills-visual {
      grid-template-columns: repeat(2, 1fr);
    }

    .philosophy-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .skills-visual {
      grid-template-columns: 1fr;
    }
  }
</style>
