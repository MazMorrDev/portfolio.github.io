---
export interface Props {
  title: string;
  description: string;
  technologies: string[];
  fullStackRepo?: string;
  backendRepo?: string;
  frontendRepo?: string;
  liveDemo?: string;
  desktopRepo?: string;
}

const {
  title,
  description,
  technologies,
  backendRepo,
  frontendRepo,
  fullStackRepo,
  desktopRepo,
  liveDemo,
} = Astro.props;
---

<article class="project-card fade-in">
  <div class="project-header">
    <h3>{title}</h3>
  </div>

  <div class="project-body">
    <p>{description}</p>

    <div class="technologies">
      {technologies.map((tech) => <span class="tech-badge">{tech}</span>)}
    </div>
  </div>

  <div class="project-footer">
    {
      backendRepo && (
        <a
          href={backendRepo}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-small"
        >
          Backend Code
        </a>
      )
    }
    {
      fullStackRepo && (
        <a
          href={fullStackRepo}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-small"
        >
          FullStack Code
        </a>
      )
    }
    {
      frontendRepo && (
        <a
          href={frontendRepo}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-small btn-outline"
        >
          Frontend Code
        </a>
      )
    }
    {
      desktopRepo && (
        <a
          href={desktopRepo}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-small btn-outline"
        >
          Desktop Code
        </a>
      )
    }
    {
      liveDemo && (
        <a
          href={liveDemo}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-small"
        >
          Live Demo
        </a>
      )
    }
  </div>
</article>

<style>
  .project-card {
    background-color: var(--secondary-black);
    border-radius: 8px;
    padding: 2rem;
    border: 1px solid var(--medium-gray);
    transition: var(--transition);
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .project-card:hover {
    border-color: var(--primary-red);
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(255, 0, 0, 0.1);
  }

  .project-header {
    margin-bottom: 1.5rem;
  }

  .project-header h3 {
    color: var(--primary-white);
    font-size: 1.5rem;
  }

  .project-body {
    flex-grow: 1;
    margin-bottom: 1.5rem;
  }

  .project-body p {
    color: #ddd;
    margin-bottom: 1.5rem;
  }

  .technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-badge {
    padding: 0.3rem 0.8rem;
    background-color: var(--primary-black);
    color: var(--primary-red);
    border-radius: 15px;
    font-size: 0.8rem;
    border: 1px solid var(--medium-gray);
  }

  .project-footer {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-small {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
  }
</style>
