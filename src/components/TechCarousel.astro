---

<div class="tech-carousel">
  <div class="carousel-container" id={`carousel-${category}`}>
    <div class="carousel-track">
      {
        techList.map((tech: Technology, index: number) => (
          <div class="carousel-slide" data-key={index}>
            <div class="tech-card">
              <div class="tech-logo">
                <img
                  src={tech.logo}
                  alt={`${tech.name} logo`}
                  width="60"
                  height="60"
                  loading="lazy"
                />
              </div>
              <div class="tech-name">{tech.name}</div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <script>
    // Función para manejar el scroll del carrusel
    function scrollCarousel(category: string, direction: number) {
      const carousel = document.getElementById(`carousel-${category}`);
      const scrollAmount = 200; // Cantidad de scroll en píxeles

      if (carousel) {
        carousel.scrollBy({
          left: direction * scrollAmount,
          behavior: "smooth",
        });
      }
    }

    // Efecto de desplazamiento automático infinito
    document.addEventListener("DOMContentLoaded", () => {
      const carousels = document.querySelectorAll(".carousel-container");

      carousels.forEach((carousel: Element) => {
        // Clonamos el contenido para efecto infinito
        const track = carousel.querySelector(".carousel-track");
        const htmlCarousel = carousel as HTMLElement;

        // Auto-scroll cada 3 segundos
        let autoScroll = setInterval(() => {
          if (htmlCarousel && "scrollBy" in htmlCarousel) {
            htmlCarousel.scrollBy({ left: 200, behavior: "smooth" });

            // Reset al llegar al final
            if (
              track &&
              htmlCarousel.scrollLeft >= (track as HTMLElement).scrollWidth / 2
            ) {
              htmlCarousel.scrollLeft = 0;
            }
          }
        }, 3000);

        // Pausar auto-scroll al hacer hover
        carousel.addEventListener("mouseenter", () => {
          clearInterval(autoScroll);
        });

        carousel.addEventListener("mouseleave", () => {
          autoScroll = setInterval(() => {
            if (htmlCarousel && "scrollBy" in htmlCarousel) {
              htmlCarousel.scrollBy({ left: 200, behavior: "smooth" });

              if (
                track &&
                htmlCarousel.scrollLeft >=
                  (track as HTMLElement).scrollWidth / 2
              ) {
                htmlCarousel.scrollLeft = 0;
              }
            }
          }, 3000);
        });
      });
    });
  </script>

  <style>
    .tech-carousel {
      position: relative;
      margin: 2rem 0;
    }

    .carousel-container {
      display: flex;
      overflow-x: auto;
      scroll-behavior: smooth;
      scrollbar-width: none; /* Firefox */
      -ms-overflow-style: none; /* IE/Edge */
      gap: 1rem;
      padding: 1rem 0;
    }

    .carousel-container::-webkit-scrollbar {
      display: none; /* Chrome/Safari/Opera */
    }

    .carousel-track {
      display: flex;
      gap: 1.5rem;
      min-width: 100%;
    }

    .carousel-slide {
      flex: 0 0 auto;
    }

    .tech-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 120px;
      height: 140px;
      background-color: var(--secondary-black);
      border-radius: 12px;
      border: 1px solid var(--medium-gray);
      padding: 1rem;
      transition: all 0.3s ease;
      cursor: pointer;
    }

    .tech-card:hover {
      transform: translateY(-5px);
      border-color: var(--primary-red);
      box-shadow: 0 10px 20px rgba(255, 0, 0, 0.1);
    }

    .tech-logo {
      width: 60px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.8rem;
    }

    .tech-logo img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      filter: grayscale(20%);
      transition: filter 0.3s ease;
    }

    .tech-card:hover .tech-logo img {
      filter: grayscale(0%) brightness(1.2);
    }

    .tech-name {
      color: var(--primary-white);
      font-size: 0.9rem;
      font-weight: 500;
      text-align: center;
      margin-top: 0.5rem;
    }

    .carousel-controls {
      display: flex;
      justify-content: center;
      gap: 1rem;
      margin-top: 1rem;
    }

    .carousel-btn {
      background-color: var(--secondary-black);
      border: 1px solid var(--medium-gray);
      color: var(--primary-white);
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.3s ease;
      font-size: 1.2rem;
    }

    .carousel-btn:hover {
      background-color: var(--primary-red);
      border-color: var(--primary-red);
    }

    .carousel-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    @media (max-width: 768px) {
      .tech-card {
        width: 100px;
        height: 120px;
      }

      .tech-logo {
        width: 50px;
        height: 50px;
      }

      .tech-name {
        font-size: 0.8rem;
      }
    }
  </style>
</div>
