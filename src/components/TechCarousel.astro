---

<div class="tech-carousel">
  <div class="carousel-container" id={`carousel-${category}`}>
    <!-- Botones de navegación - se manejan desde el script -->
    <div class="carousel-controls">
      <button class="carousel-btn prev-btn" data-category={category}>
        &#10094;
      </button>
      <button class="carousel-btn next-btn" data-category={category}>
        &#10095;
      </button>
    </div>
    <div class="carousel-track">
      {
        techList.map((tech: Technology, index: number) => (
          <div class="carousel-slide" data-key={index}>
            <div class="tech-card">
              <div class="tech-logo">
                <Image
                  src={tech.logo}
                  alt={`${tech.name} logo`}
                  width={60}
                  height={60}
                  loading="lazy"
                  format="webp"
                  quality="low"
                />
              </div>
              <div class="tech-name">{tech.name}</div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  // Función para manejar el scroll del carrusel con verificación de límites
  function scrollCarousel(category: string, direction: number): void {
    const carousel = document.getElementById(`carousel-${category}`);
    const track = carousel?.querySelector(".carousel-track") as HTMLElement;
    const scrollAmount = 300; // Cantidad de scroll en píxeles

    if (carousel && track) {
      const currentScroll = carousel.scrollLeft;
      const maxScroll = track.scrollWidth - carousel.clientWidth;

      // Verificar límites antes de desplazar
      if (direction > 0 && currentScroll >= maxScroll - 10) {
        // Ya está al final derecho, volver al inicio
        carousel.scrollTo({ left: 0, behavior: "smooth" });
      } else if (direction < 0 && currentScroll <= 10) {
        // Ya está al inicio, ir al final
        carousel.scrollTo({ left: maxScroll, behavior: "smooth" });
      } else {
        // Desplazar normalmente
        carousel.scrollBy({
          left: direction * scrollAmount,
          behavior: "smooth",
        });
      }
    }
  }

  // Manejar clicks en botones
  function handleCarouselButtonClick(event: MouseEvent): void {
    const button = event.currentTarget as HTMLButtonElement;
    const category = button.dataset.category;
    const direction = button.classList.contains("prev-btn") ? -1 : 1;

    if (category) {
      scrollCarousel(category, direction);
    }
  }

  document.addEventListener("DOMContentLoaded", (): void => {
    const carousels = document.querySelectorAll(".carousel-container");

    carousels.forEach((carousel: Element): void => {
      const carouselEl = carousel as HTMLElement;
      const category = carouselEl.id.replace("carousel-", "");
      const prevBtn = carouselEl.parentElement?.querySelector(
        ".prev-btn",
      ) as HTMLButtonElement;
      const nextBtn = carouselEl.parentElement?.querySelector(
        ".next-btn",
      ) as HTMLButtonElement;
      const track = carousel.querySelector(".carousel-track") as HTMLElement;

      // Añadir event listeners a los botones
      if (prevBtn) {
        prevBtn.addEventListener("click", handleCarouselButtonClick);
      }

      if (nextBtn) {
        nextBtn.addEventListener("click", handleCarouselButtonClick);
      }

      // Función para actualizar estado de botones
      function updateButtons(): void {
        if (!carouselEl || !track || !prevBtn || !nextBtn) return;

        const currentScroll = carouselEl.scrollLeft;
        const maxScroll = track.scrollWidth - carouselEl.clientWidth;
        const tolerance = 10; // Margen de error

        // Actualizar botón izquierdo
        if (currentScroll <= tolerance) {
          prevBtn.style.opacity = "0.5";
          prevBtn.style.cursor = "not-allowed";
        } else {
          prevBtn.style.opacity = "1";
          prevBtn.style.cursor = "pointer";
        }

        // Actualizar botón derecho
        if (currentScroll >= maxScroll - tolerance) {
          nextBtn.style.opacity = "0.5";
          nextBtn.style.cursor = "not-allowed";
        } else {
          nextBtn.style.opacity = "1";
          nextBtn.style.cursor = "pointer";
        }
      }

      // Actualizar botones al cargar
      updateButtons();

      // Actualizar botones al hacer scroll
      carousel.addEventListener("scroll", updateButtons);

      // Actualizar botones al redimensionar ventana
      window.addEventListener("resize", updateButtons);
    });
  });
</script>

<style>
  /* Tus estilos permanecen iguales */
  .tech-carousel {
    position: relative;
    margin: 2rem 0;
  }

  .carousel-container {
    display: flex;
    justify-content: center;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    gap: 1rem;
    padding: 1rem 0;
  }

  .carousel-container::-webkit-scrollbar {
    display: none;
  }

  .carousel-controls {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
    padding: 0.5rem;
  }

  .carousel-btn {
    background-color: var(--secondary-black);
    border: 1px solid var(--medium-gray);
    color: var(--primary-white);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 1.2rem;
    font-weight: bold;
  }

  .carousel-btn:hover:not(:disabled) {
    background-color: var(--primary-red);
    border-color: var(--primary-red);
    transform: scale(1.1);
  }

  /* Posicionamiento relativo para los botones */
  .tech-carousel {
    position: relative;
    margin: 2rem 0;
  }

  /* Versión alternativa: botones flotantes a los lados */
  .carousel-btn.prev-btn {
    position: absolute;
    left: -20px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
  }

  .carousel-btn.next-btn {
    position: absolute;
    right: -20px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
  }

  @media (max-width: 768px) {
    .carousel-btn.prev-btn {
      left: 5px;
    }

    .carousel-btn.next-btn {
      right: 5px;
    }

    .carousel-btn {
      width: 35px;
      height: 35px;
      font-size: 1rem;
    }
  }

  .carousel-track {
    display: flex;
    gap: 1.5rem;
    width: fit-content;
  }

  .carousel-slide {
    flex: 0 0 auto;
  }

  .tech-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 120px;
    height: 140px;
    background-color: var(--secondary-black);
    border-radius: 12px;
    border: 1px solid var(--medium-gray);
    padding: 1rem;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .tech-card:hover {
    transform: translateY(-5px);
    border-color: var(--primary-red);
    box-shadow: 0 10px 20px rgba(255, 0, 0, 0.1);
  }

  .tech-logo {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.8rem;
  }

  .tech-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: grayscale(20%);
    transition: filter 0.3s ease;
  }

  .tech-card:hover .tech-logo img {
    filter: grayscale(0%) brightness(1.2);
  }

  .tech-name {
    color: var(--primary-white);
    font-size: 0.9rem;
    font-weight: 500;
    text-align: center;
    margin-top: 0.5rem;
  }

  .carousel-controls {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  .carousel-btn {
    background-color: var(--secondary-black);
    border: 1px solid var(--medium-gray);
    color: var(--primary-white);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 1.2rem;
  }

  .carousel-btn:hover {
    background-color: var(--primary-red);
    border-color: var(--primary-red);
  }

  .carousel-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (max-width: 768px) {
    .tech-card {
      width: 100px;
      height: 120px;
    }

    .tech-logo {
      width: 50px;
      height: 50px;
    }

    .tech-name {
      font-size: 0.8rem;
    }
  }
</style>
